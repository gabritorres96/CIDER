                       _fabs, _floor, _ceil, _pow, _fork, _execve, _fopen, _signal, dyld_stub_binder, _qsort,
                       _fputs, _fputc, _putc, _fwrite, _fflush, _printf, _fprintf, _sprintf, _snprintf, _vprintf,
                       _vfprintf, _vsprintf, _vsnprintf, ___stdinp, ___stdoutp, ___stderrp,
                       _open, _close, _read, _lseek, '_stat$INODE64', '_fstat$INODE64', _stat, _fstat, _access, _getcwd,
                       _gettimeofday, _clock_gettime, _time, _nanosleep, _usleep, _sleep, ___error,
                       _strcpy, _strncpy, _strcat, _strchr, _strrchr, _strstr, _strdup, _atoi, _strtol,
                       _sin, _cos, _tan, _exp, _log, _log10, _atan, _atan2, _fmod, _ldexp, _frexp, _div, _ldiv,
